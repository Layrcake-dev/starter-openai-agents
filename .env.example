# Layrcake key. Create one at https://layrcake.dev/connect
LAYRCAKE_API_KEY=
# OpenAI key for the Agents SDK. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Credit ceiling for one run. A run usually costs 50 to 70 credits.
BUDGET=100
# Optional. The name every drafted email is signed with. Without it, emails are signed [Your name]
# and need filling in before you approve the campaign.
# SENDER_NAME=
# Optional. Defaults to the Agents SDK default model.
# MODEL=
# Optional. The Agents SDK sends traces to your OpenAI dashboard. Set to 1 to turn that off.
# OPENAI_AGENTS_DISABLE_TRACING=1
